#!/usr/bin/env bash
#
# run_full_evaluation.sh - One-command evaluation orchestrator for CellIFT Ibex.
#
# Default flow:
#   1) Build CSV logger target (FuseSoC)
#   2) Run single-pair TVLA (run_tvla.sh)
#   3) Run multi-trace TVLA (run_multi_trace_tvla.sh)
#   4) Optionally run HW-model validation (hw_model_test.py) if full 256 sweep exists

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

ENV_SH="/mnt/nvme1n1p1/cellift-meta-leakage/env.sh"
OPENTITAN_ROOT_DEFAULT="/mnt/nvme1n1p1/chipyard-1.11.0/generators/ibex/src/main/resources/vsrc/lowrisc_ibex/vendor/lowrisc_ip"

usage() {
    cat <<'EOF'
Usage:
  ./run_full_evaluation.sh [options]

Core options:
  --simlen N                 Simulation cycles (default: 3000)
  --results DIR              Root output directory (default: results/full_eval)
  --scenario-a NAME          Group A scenario (default: scenario_aes128_key1)
  --scenario-b NAME          Group B scenario (default: scenario_aes128_key2)
    --n N                      Trace pairs for multi-trace stage (default: 2)
  --jobs N                   Parallel jobs for multi-trace stage (default: 1)
  --plot                     Enable plot generation for analysis scripts
    --log-file PATH            Write detailed output to this log file
    --seed N                   Seed for auto-generated scenario plaintexts (default: 42)
    --no-auto-generate-scenarios
                                                            Disable automatic scenario generation/compilation

Build options:
  --skip-build               Skip FuseSoC build stage
  --opentitan-root PATH      Override OPENTITAN_ROOT for FuseSoC build

HW-model stage:
  --run-hw-model             Run hw_model_test.py after multi-trace stage
  --hw-byte N                Byte index for hw_model_test.py (default: 0)
  --hw-input DIR             Directory with group_a_000..255 CSVs
                             (default: <results>/multi)
  --strict-hw-model          Fail if HW-model prerequisites are missing

Control:
  --help                     Show this help

Examples:
    ./run_full_evaluation.sh --plot
  ./run_full_evaluation.sh --n 20 --jobs 8 --plot
  ./run_full_evaluation.sh --n 256 --jobs 8 --run-hw-model --plot
EOF
}

SIMLEN=3000
RESULTS_DIR="${SCRIPT_DIR}/results/full_eval"
SCENARIO_A="scenario_aes128_key1"
SCENARIO_B="scenario_aes128_key2"
N=2
JOBS=1
PLOT=0
SKIP_BUILD=0
RUN_HW_MODEL=0
HW_BYTE=0
HW_INPUT_DIR=""
STRICT_HW_MODEL=0
LOG_FILE=""
SEED=42
AUTO_GENERATE_SCENARIOS=1
OPENTITAN_ROOT="${OPENTITAN_ROOT:-$OPENTITAN_ROOT_DEFAULT}"

SINGLE_SCENARIO_A=""
SINGLE_SCENARIO_B=""
MULTI_SCENARIO_A=""
MULTI_SCENARIO_B=""

has_indexed_scenario_range() {
    local prefix="$1"
    local n="$2"
    local i idx
    for i in $(seq 0 $((n - 1))); do
        idx=$(printf "%03d" "$i")
        if [[ ! -d "${SCRIPT_DIR}/sw/${prefix}_${idx}" ]]; then
            return 1
        fi
    done
    return 0
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --simlen) SIMLEN="$2"; shift 2 ;;
        --results) RESULTS_DIR="$2"; shift 2 ;;
        --scenario-a) SCENARIO_A="$2"; shift 2 ;;
        --scenario-b) SCENARIO_B="$2"; shift 2 ;;
        --n) N="$2"; shift 2 ;;
        --jobs) JOBS="$2"; shift 2 ;;
        --plot) PLOT=1; shift ;;
        --log-file) LOG_FILE="$2"; shift 2 ;;
        --seed) SEED="$2"; shift 2 ;;
        --no-auto-generate-scenarios) AUTO_GENERATE_SCENARIOS=0; shift ;;
        --skip-build) SKIP_BUILD=1; shift ;;
        --opentitan-root) OPENTITAN_ROOT="$2"; shift 2 ;;
        --run-hw-model) RUN_HW_MODEL=1; shift ;;
        --hw-byte) HW_BYTE="$2"; shift 2 ;;
        --hw-input) HW_INPUT_DIR="$2"; shift 2 ;;
        --strict-hw-model) STRICT_HW_MODEL=1; shift ;;
        --help|-h) usage; exit 0 ;;
        *)
            echo "ERROR: unknown argument: $1" >&2
            usage
            exit 1
            ;;
    esac
done

if ! [[ "$SIMLEN" =~ ^[0-9]+$ ]] || [[ "$SIMLEN" -lt 1 ]]; then
    echo "ERROR: --simlen must be a positive integer" >&2
    exit 1
fi
if ! [[ "$N" =~ ^[0-9]+$ ]] || [[ "$N" -lt 1 ]]; then
    echo "ERROR: --n must be a positive integer" >&2
    exit 1
fi
if ! [[ "$JOBS" =~ ^[0-9]+$ ]] || [[ "$JOBS" -lt 1 ]]; then
    echo "ERROR: --jobs must be a positive integer" >&2
    exit 1
fi
if ! [[ "$HW_BYTE" =~ ^[0-9]+$ ]] || [[ "$HW_BYTE" -gt 15 ]]; then
    echo "ERROR: --hw-byte must be in [0,15]" >&2
    exit 1
fi

SINGLE_SCENARIO_A="$SCENARIO_A"
SINGLE_SCENARIO_B="$SCENARIO_B"
MULTI_SCENARIO_A="$SCENARIO_A"
MULTI_SCENARIO_B="$SCENARIO_B"

if [[ "$N" -gt 1 ]]; then
     if [[ -d "${SCRIPT_DIR}/sw/${MULTI_SCENARIO_A}" && -d "${SCRIPT_DIR}/sw/${MULTI_SCENARIO_B}" ]] && \
         [[ ! -d "${SCRIPT_DIR}/sw/${MULTI_SCENARIO_A}_000" || ! -d "${SCRIPT_DIR}/sw/${MULTI_SCENARIO_B}_000" ]]; then
        if [[ "$AUTO_GENERATE_SCENARIOS" -eq 0 ]]; then
            echo "ERROR: --n ${N} requires indexed scenarios, but only base scenarios were provided:" >&2
            echo "       A='${MULTI_SCENARIO_A}', B='${MULTI_SCENARIO_B}'" >&2
            echo "       Missing expected directories: ${MULTI_SCENARIO_A}_000 / ${MULTI_SCENARIO_B}_000" >&2
            echo "       Re-run without --no-auto-generate-scenarios to auto-generate." >&2
            exit 1
        fi

        GEN_TYPE=""
        if [[ "$MULTI_SCENARIO_A" == "scenario_aes128_key1" && "$MULTI_SCENARIO_B" == "scenario_aes128_key2" ]]; then
            GEN_TYPE="unmasked"
        elif [[ "$MULTI_SCENARIO_A" == "scenario_aes128_masked_key1" && "$MULTI_SCENARIO_B" == "scenario_aes128_masked_key2" ]]; then
            GEN_TYPE="masked"
        fi

        if [[ -z "$GEN_TYPE" ]]; then
            echo "ERROR: cannot auto-generate for scenario pair '${MULTI_SCENARIO_A}'/'${MULTI_SCENARIO_B}'." >&2
            echo "       Supported auto-generation pairs:" >&2
            echo "         scenario_aes128_key1 / scenario_aes128_key2" >&2
            echo "         scenario_aes128_masked_key1 / scenario_aes128_masked_key2" >&2
            echo "       Provide indexed prefixes manually for custom scenarios." >&2
            exit 1
        fi

        GEN_PREFIX_A="multi_${GEN_TYPE}_a"
        GEN_PREFIX_B="multi_${GEN_TYPE}_b"
        MULTI_SCENARIO_A="$GEN_PREFIX_A"
        MULTI_SCENARIO_B="$GEN_PREFIX_B"
    fi
fi

SINGLE_OUT="${RESULTS_DIR}/single"
MULTI_OUT="${RESULTS_DIR}/multi"
HW_INPUT_DIR="${HW_INPUT_DIR:-$MULTI_OUT}"

mkdir -p "$RESULTS_DIR"

if [[ -z "$LOG_FILE" ]]; then
    LOG_FILE="${RESULTS_DIR}/run_full_evaluation.log"
fi

: > "$LOG_FILE"

EXTRA_ARGS=()
if [[ "$PLOT" -eq 1 ]]; then
    EXTRA_ARGS+=("--plot")
fi

echo "============================================================"
echo " CellIFT Ibex Full Evaluation"
echo "============================================================"
echo " SIMLEN      : $SIMLEN"
echo " RESULTS     : $RESULTS_DIR"
echo " GROUP A     : $SCENARIO_A"
echo " GROUP B     : $SCENARIO_B"
echo " SINGLE A/B  : ${SINGLE_SCENARIO_A} / ${SINGLE_SCENARIO_B}"
echo " MULTI A/B   : ${MULTI_SCENARIO_A} / ${MULTI_SCENARIO_B}"
echo " N (multi)   : $N"
echo " JOBS        : $JOBS"
echo " PLOT        : $PLOT"
echo " RUN_HW_MODEL: $RUN_HW_MODEL"
echo " LOG_FILE    : $LOG_FILE"
echo " SEED        : $SEED"
echo " AUTO_GEN    : $AUTO_GENERATE_SCENARIOS"
echo ""

source "$ENV_SH"

NEED_GENERATION=0
if [[ "$N" -gt 1 && "$AUTO_GENERATE_SCENARIOS" -eq 1 ]] && \
    [[ "$MULTI_SCENARIO_A" =~ ^multi_(unmasked|masked)_a$ && "$MULTI_SCENARIO_B" =~ ^multi_(unmasked|masked)_b$ ]]; then
    GEN_TYPE="${BASH_REMATCH[1]}"
    if ! has_indexed_scenario_range "$MULTI_SCENARIO_A" "$N" || ! has_indexed_scenario_range "$MULTI_SCENARIO_B" "$N"; then
        NEED_GENERATION=1
    fi
fi

if [[ "$NEED_GENERATION" -eq 1 ]]; then
    echo "[0/4] Generating and compiling scenarios (${GEN_TYPE}, N=${N}, seed=${SEED})"
    {
        echo "[SCENARIO GEN] $(date -Iseconds)"
        python3 "$SCRIPT_DIR/gen_scenarios.py" --type "$GEN_TYPE" --group a --n "$N" --seed "$SEED"
        python3 "$SCRIPT_DIR/gen_scenarios.py" --type "$GEN_TYPE" --group b --n "$N" --seed "$SEED"
        bash "$SCRIPT_DIR/compile_scenarios.sh" "multi_${GEN_TYPE}_a"
        bash "$SCRIPT_DIR/compile_scenarios.sh" "multi_${GEN_TYPE}_b"
    } >> "$LOG_FILE" 2>&1
fi

if [[ "$SKIP_BUILD" -eq 0 ]]; then
    echo "[1/4] Building CSV logger target"
    {
        echo "[BUILD] $(date -Iseconds)"
        rm -f fusesoc.conf
        fusesoc library add run_cellift_csvlog .
        OPENTITAN_ROOT="$OPENTITAN_ROOT" fusesoc --cores-root="$OPENTITAN_ROOT" run --build run_cellift_csvlog
    } >> "$LOG_FILE" 2>&1
else
    echo "[1/4] Skipping build stage (--skip-build)"
fi

echo "[2/4] Running single-pair TVLA"
if ! bash "$SCRIPT_DIR/run_tvla.sh" \
    "$SIMLEN" \
    "$SINGLE_OUT" \
    "$SINGLE_SCENARIO_A" \
    "$SINGLE_SCENARIO_B" \
    "${EXTRA_ARGS[@]}" >> "$LOG_FILE" 2>&1; then
    echo "ERROR: single-pair TVLA failed. See log: $LOG_FILE"
    exit 1
fi

echo "[3/4] Running multi-trace TVLA"
SKIP_WELCH_MULTI=0
if [[ "$N" -lt 2 ]]; then
    SKIP_WELCH_MULTI=1
fi

if ! JOBS="$JOBS" SKIP_WELCH="$SKIP_WELCH_MULTI" LOGFILE="$LOG_FILE" bash "$SCRIPT_DIR/run_multi_trace_tvla.sh" \
    "$N" \
    "$SIMLEN" \
    "$MULTI_OUT" \
    "$MULTI_SCENARIO_A" \
    "$MULTI_SCENARIO_B" \
    "${EXTRA_ARGS[@]}" >> "$LOG_FILE" 2>&1; then
    echo "ERROR: multi-trace TVLA failed. See log: $LOG_FILE"
    exit 1
fi

if [[ "$RUN_HW_MODEL" -eq 1 ]]; then
    echo "[4/4] Running HW-model validation"

    # hw_model_test.py expects a full 256-value sweep for group_a_000..255.
    missing=0
    for i in $(seq 0 255); do
        f=$(printf "%s/group_a_%03d.csv" "$HW_INPUT_DIR" "$i")
        if [[ ! -f "$f" ]]; then
            missing=1
            break
        fi
    done

    if [[ "$missing" -eq 1 ]]; then
        msg="HW-model prerequisites missing: expected group_a_000..255.csv in $HW_INPUT_DIR"
        if [[ "$STRICT_HW_MODEL" -eq 1 ]]; then
            echo "ERROR: $msg" >&2
            exit 1
        fi
        echo "WARNING: $msg"
        echo "         Skipping HW-model stage. Re-run with --strict-hw-model to fail instead."
    else
        if ! python3 "$SCRIPT_DIR/hw_model_test.py" \
            "$HW_INPUT_DIR" \
            --byte "$HW_BYTE" \
            --out "$HW_INPUT_DIR/hw_model" \
            "${EXTRA_ARGS[@]}" >> "$LOG_FILE" 2>&1; then
            echo "ERROR: HW-model stage failed. See log: $LOG_FILE"
            exit 1
        fi
    fi
else
    echo "[4/4] HW-model stage disabled (use --run-hw-model)"
fi

echo ""
echo "Done. Outputs:"
echo "  Single-pair TVLA : $SINGLE_OUT"
echo "  Multi-trace TVLA : $MULTI_OUT"
if [[ "$RUN_HW_MODEL" -eq 1 ]]; then
    echo "  HW-model prefix  : $HW_INPUT_DIR/hw_model"
fi
echo "  Detailed log     : $LOG_FILE"
