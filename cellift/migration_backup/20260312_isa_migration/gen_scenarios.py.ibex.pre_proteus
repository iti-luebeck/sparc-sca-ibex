#!/usr/bin/env python3
"""
Ibex scenario generator adapted from Proteus flow.

Generates matched-pair plaintext scenarios for TVLA:
  sw/multi_{type}_{group}_{i:03d}
  taint_data/multi_{type}_{group}_{i:03d}

Supported types:
  - unmasked: templates scenario_aes128_key1/key2
  - masked:   templates scenario_aes128_masked_key1/key2
"""

import argparse
import random
import re
import shutil
from pathlib import Path

SCRIPT_DIR = Path(__file__).parent

PROFILES = {
    "unmasked": {
        "templates": {"a": "scenario_aes128_key1", "b": "scenario_aes128_key2"},
        "patch_labels": [("aes_plaintext", 16)],
        "protected_labels": {"aes_key": 16},
    },
    "masked": {
        "templates": {"a": "scenario_aes128_masked_key1", "b": "scenario_aes128_masked_key2"},
        "patch_labels": [("aes_plaintext", 16), ("aes_state_mask", 16)],
        "protected_labels": {"aes_key_share0": 16, "aes_key_mask": 16},
    },
}


def bytes_to_asm(data: bytes) -> str:
    lines = []
    for i in range(0, len(data), 4):
        row = ", ".join(f"0x{x:02x}" for x in data[i:i + 4])
        lines.append(f"    .byte {row}")
    return "\n".join(lines)


def replace_label_bytes(src: str, label: str, new_bytes: bytes) -> str:
    if len(new_bytes) % 4 != 0:
        raise ValueError(f"{label}: byte count must be multiple of 4")
    n_lines = len(new_bytes) // 4
    pattern = re.compile(
        r"([ \t]*" + re.escape(label) + r":\n)"
        + r"(?:[ \t]*\.byte[^\n]*\n){" + str(n_lines) + r"}",
        re.MULTILINE,
    )
    replacement = r"\1" + bytes_to_asm(new_bytes) + "\n"
    out, count = pattern.subn(replacement, src)
    if count != 1:
        raise ValueError(f"{label}: expected exactly one match, found {count}")
    return out


def verify_protected(new_src: str, old_src: str, labels: dict) -> None:
    for label, n_bytes in labels.items():
        if n_bytes % 4 != 0:
            raise RuntimeError(f"{label}: protected byte size must be multiple of 4")
        n_lines = n_bytes // 4
        pattern = re.compile(
            r"[ \t]*" + re.escape(label) + r":\n"
            + r"((?:[ \t]*\.byte[^\n]*\n){" + str(n_lines) + r"})",
            re.MULTILINE,
        )
        mo = pattern.search(old_src)
        mn = pattern.search(new_src)
        if mo and mn and mo.group(1) != mn.group(1):
            raise RuntimeError(f"Protected label changed unexpectedly: {label}")


def gen_one(scenario_type: str, group: str, idx: int, seed_value: int) -> None:
    profile = PROFILES[scenario_type]
    tpl = profile["templates"][group]

    src_sw = SCRIPT_DIR / "sw" / tpl
    src_taint = SCRIPT_DIR / "taint_data" / tpl

    out_name = f"multi_{scenario_type}_{group}_{idx:03d}"
    dst_sw = SCRIPT_DIR / "sw" / out_name
    dst_taint = SCRIPT_DIR / "taint_data" / out_name

    if dst_sw.exists():
        shutil.rmtree(dst_sw)
    shutil.copytree(src_sw, dst_sw)

    build_dir = dst_sw / "build"
    if build_dir.exists():
        shutil.rmtree(build_dir)

    main_s = dst_sw / "main.S"
    old_src = main_s.read_text()
    new_src = old_src

    rng = random.Random(seed_value)
    for label, n_bytes in profile["patch_labels"]:
        rand_bytes = bytes(rng.randint(0, 255) for _ in range(n_bytes))
        new_src = replace_label_bytes(new_src, label, rand_bytes)

    verify_protected(new_src, old_src, profile["protected_labels"])
    main_s.write_text(new_src)

    if dst_taint.exists():
        shutil.rmtree(dst_taint)
    shutil.copytree(src_taint, dst_taint)

    print(f"  {out_name}")


def main() -> None:
    ap = argparse.ArgumentParser(description="Generate Ibex multi-trace scenarios")
    ap.add_argument("--type", required=True, choices=["unmasked", "masked"])
    ap.add_argument("--group", required=True, choices=["a", "b"])
    ap.add_argument("--n", required=True, type=int)
    ap.add_argument("--seed", default=42, type=int)
    args = ap.parse_args()

    print(f"Generating {args.n} {args.type} group-{args.group} scenarios (seed={args.seed})")
    for i in range(args.n):
        gen_one(args.type, args.group, i, args.seed * 10000 + i)

    prefix = f"multi_{args.type}_{args.group}"
    print("\nDone.")
    print(f"  sw/{prefix}_000 .. sw/{prefix}_{args.n-1:03d}")
    print(f"  taint_data/{prefix}_000 .. taint_data/{prefix}_{args.n-1:03d}")
    print(f"\nNext: ./compile_scenarios.sh {prefix}")


if __name__ == "__main__":
    main()
