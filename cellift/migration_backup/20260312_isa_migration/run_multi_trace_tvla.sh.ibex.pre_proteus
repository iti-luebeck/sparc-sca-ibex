#!/usr/bin/env bash
#
# run_multi_trace_tvla.sh - Multi-trace TVLA pipeline for CellIFT Ibex.
#
# For each trace index i, runs two matched scenarios and stores CSV output:
#   Group A: sw/{scenario_a}/build/app.elf
#   Group B: sw/{scenario_b}/build/app.elf
#
# Default naming follows Proteus convention:
#   scenario_a = ${PREFIX_A}_${i:03d}
#   scenario_b = ${PREFIX_B}_${i:03d}
#
# For N=1, if sw/${PREFIX_A}/build/app.elf exists (and same for B), the script
# uses PREFIX_A/PREFIX_B directly. This supports quick deterministic checks with
# existing scenarios like scenario_aes128_key1 and scenario_aes128_key2.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

N="${1:-20}"
SIMLEN="${2:-3000}"
OUTDIR="${3:-${SCRIPT_DIR}/results/multi_tvla}"
PREFIX_A="${4:-multi_unmasked_a}"
PREFIX_B="${5:-multi_unmasked_b}"
shift 5 2>/dev/null || true

JOBS="${JOBS:-1}"
LEADTICKS="${LEADTICKS:-5}"
SKIP_WELCH="${SKIP_WELCH:-0}"
AUTO_BUILD_ELF="${AUTO_BUILD_ELF:-1}"

if ! [[ "$LEADTICKS" =~ ^[0-9]+$ ]]; then
    echo "ERROR: LEADTICKS must be a non-negative integer (got '${LEADTICKS}')"
    exit 1
fi
if ! [[ "$N" =~ ^[0-9]+$ ]] || [[ "$N" -lt 1 ]]; then
    echo "ERROR: N must be at least 1 (got '${N}')"
    exit 1
fi
if ! [[ "$JOBS" =~ ^[0-9]+$ ]] || [[ "$JOBS" -lt 1 ]]; then
    echo "ERROR: JOBS must be a positive integer (got '${JOBS}')"
    exit 1
fi
if ! [[ "$SKIP_WELCH" =~ ^[0-9]+$ ]]; then
    echo "ERROR: SKIP_WELCH must be 0 or 1 (got '${SKIP_WELCH}')"
    exit 1
fi
if ! [[ "$AUTO_BUILD_ELF" =~ ^[0-9]+$ ]]; then
    echo "ERROR: AUTO_BUILD_ELF must be 0 or 1 (got '${AUTO_BUILD_ELF}')"
    exit 1
fi

EXPECTED_ROWS=$(( SIMLEN - LEADTICKS ))
if [[ "$EXPECTED_ROWS" -le 0 ]]; then
    echo "ERROR: expected CSV rows must be positive (SIMLEN=${SIMLEN}, LEADTICKS=${LEADTICKS})"
    exit 1
fi

ENV_SH="/mnt/nvme1n1p1/cellift-meta-leakage/env.sh"
CSV_BIN="${SCRIPT_DIR}/build/run_cellift_csvlog_0.1/default-verilator/Vibex_tiny_soc"

source "$ENV_SH"

if [[ ! -x "$CSV_BIN" ]]; then
    echo "ERROR: CSV logger binary not found: $CSV_BIN"
    echo "       Build it with:"
    echo "         . /mnt/nvme1n1p1/cellift-meta-leakage/env.sh"
    echo "         rm -f fusesoc.conf"
    echo "         fusesoc library add run_cellift_csvlog ."
    echo "         fusesoc --cores-root=\$OPENTITAN_ROOT run --build run_cellift_csvlog"
    exit 1
fi

mkdir -p "$OUTDIR"
LOGFILE="${LOGFILE:-${OUTDIR}/run_multi_trace_tvla.log}"

: > "$LOGFILE"

validate_csv() {
    local csv_path="$1"
    local expect_rows="$2"

    if [[ ! -s "$csv_path" ]]; then
        echo "  ERROR: CSV missing or empty: $csv_path"
        return 1
    fi

    python3 - "$csv_path" "$expect_rows" <<'PY'
import csv
import sys

path = sys.argv[1]
expect_rows = int(sys.argv[2])
need = ["cycle", "leakage_counter_t0", "hamming_weight_counter_t0", "hamming_distance_counter_t0"]

rows = 0
prev = None
with open(path, newline="") as f:
    r = csv.DictReader(f)
    if r.fieldnames != need:
        print(f"ERROR: CSV header mismatch in {path}: {r.fieldnames}")
        sys.exit(2)
    for row in r:
        rows += 1
        vals = [int(row[k]) for k in need]
        cyc, lc, hw, hd = vals
        if cyc != rows - 1:
            print(f"ERROR: non-consecutive cycle index in {path} at row {rows}: got {cyc}")
            sys.exit(3)
        if prev is not None:
            if lc < prev[0] or hw < prev[1] or hd < prev[2]:
                print(f"ERROR: counter monotonicity violated in {path} at cycle {cyc}")
                sys.exit(4)
        prev = (lc, hw, hd)

if rows != expect_rows:
    print(f"ERROR: CSV row count mismatch in {path}: got {rows}, expected {expect_rows}")
    sys.exit(5)
PY
}

run_trace() {
    local scenario="$1"
    local csv_out="$2"

    local elf="${SCRIPT_DIR}/sw/${scenario}/build/app.elf"
    local taint="${SCRIPT_DIR}/taint_data/${scenario}/taint_data.txt"

    if [[ ! -f "$taint" ]]; then
        echo "  ERROR: taint file not found: $taint"
        exit 1
    fi

    {
        echo "============================================================"
        echo "TRACE scenario=${scenario} csv=${csv_out}"
        echo "============================================================"
        SIMLEN="$SIMLEN" \
        TRACEFILE=/dev/null \
        CSVFILE="$csv_out" \
        SIMROMELF="$elf" \
        SIMSRAMELF="$elf" \
        SIMROMTAINT="$taint" \
        SIMSRAMTAINT="$taint" \
        "$CSV_BIN" 2>&1 | grep -v "Writing ELF word" || true
        echo ""
    } >> "$LOGFILE"
}

ensure_scenario_elf() {
    local scenario="$1"
    local scen_dir="${SCRIPT_DIR}/sw/${scenario}"
    local elf="${scen_dir}/build/app.elf"
    local makefile="${scen_dir}/Makefile"

    if [[ -f "$elf" ]]; then
        return 0
    fi

    if [[ "$AUTO_BUILD_ELF" -eq 0 ]]; then
        echo "    ELF missing and AUTO_BUILD_ELF=0: ${elf}"
        return 1
    fi

    if [[ ! -d "$scen_dir" ]]; then
        echo "    Scenario directory missing: ${scen_dir}"
        return 1
    fi
    if [[ ! -f "$makefile" ]]; then
        echo "    Scenario Makefile missing: ${makefile}"
        return 1
    fi

    echo "    Building missing ELF for scenario '${scenario}'..."
    if ! make -C "$scen_dir" build/app.elf >> "$LOGFILE" 2>&1; then
        echo "    Build failed for scenario '${scenario}'. See log: ${LOGFILE}"
        return 1
    fi

    if [[ ! -f "$elf" ]]; then
        echo "    Build completed but ELF still missing: ${elf}"
        return 1
    fi

    return 0
}

scenario_for_idx() {
    local prefix="$1"
    local idx="$2"

    if [[ "$N" -eq 1 && -f "${SCRIPT_DIR}/sw/${prefix}/build/app.elf" ]]; then
        echo "$prefix"
    else
        echo "${prefix}_${idx}"
    fi
}

run_pair() {
    local idx="$1"
    local scenario_a
    local scenario_b
    scenario_a="$(scenario_for_idx "$PREFIX_A" "$idx")"
    scenario_b="$(scenario_for_idx "$PREFIX_B" "$idx")"

    local csv_a="${OUTDIR}/group_a_${idx}.csv"
    local csv_b="${OUTDIR}/group_b_${idx}.csv"

    echo "-- Trace ${idx} / $(printf "%03d" $((N-1))) --"

    if [[ -f "$csv_a" && -f "$csv_b" ]]; then
        echo "  Already exists, skipping (delete to re-run)"
        return 0
    fi

    echo "  [A] ${scenario_a}"
    run_trace "$scenario_a" "$csv_a"
    validate_csv "$csv_a" "$EXPECTED_ROWS"
    echo "      -> ${csv_a}"

    echo "  [B] ${scenario_b}"
    run_trace "$scenario_b" "$csv_b"
    validate_csv "$csv_b" "$EXPECTED_ROWS"
    echo "      -> ${csv_b}"
    echo ""
}

preflight_check_scenarios() {
    local missing=0
    local shown=0
    local idx scenario_a scenario_b elf_a elf_b taint_a taint_b

    for i in $(seq 0 $((N - 1))); do
        idx=$(printf "%03d" "$i")
        scenario_a="$(scenario_for_idx "$PREFIX_A" "$idx")"
        scenario_b="$(scenario_for_idx "$PREFIX_B" "$idx")"

        elf_a="${SCRIPT_DIR}/sw/${scenario_a}/build/app.elf"
        elf_b="${SCRIPT_DIR}/sw/${scenario_b}/build/app.elf"
        taint_a="${SCRIPT_DIR}/taint_data/${scenario_a}/taint_data.txt"
        taint_b="${SCRIPT_DIR}/taint_data/${scenario_b}/taint_data.txt"

        if ! ensure_scenario_elf "$scenario_a"; then
            missing=1
        fi
        if ! ensure_scenario_elf "$scenario_b"; then
            missing=1
        fi

        if [[ ! -f "$elf_a" || ! -f "$elf_b" || ! -f "$taint_a" || ! -f "$taint_b" ]]; then
            missing=1
            if [[ "$shown" -lt 6 ]]; then
                echo "  Missing artifacts for index ${idx}:"
                [[ -f "$elf_a" ]] || echo "    ELF A   : ${elf_a}"
                [[ -f "$elf_b" ]] || echo "    ELF B   : ${elf_b}"
                [[ -f "$taint_a" ]] || echo "    TAINT A : ${taint_a}"
                [[ -f "$taint_b" ]] || echo "    TAINT B : ${taint_b}"
                shown=$((shown + 1))
            fi
        fi
    done

    if [[ "$missing" -ne 0 ]]; then
        echo ""
        echo "ERROR: scenario preflight failed."
        echo "       Requested N=${N} requires matching scenario assets for every index."
        echo "       Prefixes used: A='${PREFIX_A}', B='${PREFIX_B}'."
        echo ""
        echo "Hints:"
        echo "  1) For deterministic key1/key2 checks, use N=1."
        echo "     Example: bash run_multi_trace_tvla.sh 1 ${SIMLEN} ${OUTDIR} ${PREFIX_A} ${PREFIX_B}"
        echo "  2) For Welch TVLA (N>=2), provide indexed scenarios like <prefix>_000.. and taint data."
        echo "  3) For hw_model_test.py, you need a full 256-case key-byte sweep (group_a_000..255)."
        exit 1
    fi
}

echo "============================================================"
echo " CellIFT Multi-Trace TVLA (Ibex) - N=${N} SIMLEN=${SIMLEN}"
echo " Group A prefix : ${PREFIX_A}"
echo " Group B prefix : ${PREFIX_B}"
echo " Output dir     : ${OUTDIR}"
echo " Parallel jobs  : ${JOBS}"
echo " Skip Welch    : ${SKIP_WELCH}"
echo " Auto-build ELF: ${AUTO_BUILD_ELF}"
echo " Data-row check : SIMLEN-LEADTICKS = ${SIMLEN}-${LEADTICKS} = ${EXPECTED_ROWS}"
echo " Log file      : ${LOGFILE}"
echo "============================================================"
echo ""

echo "Preflight: validating scenario ELF/taint availability..."
preflight_check_scenarios
echo "Preflight: OK"
echo ""

t_start=$(date +%s)

if [[ "$JOBS" -eq 1 ]]; then
    for i in $(seq 0 $((N - 1))); do
        idx=$(printf "%03d" "$i")
        run_pair "$idx"
    done
else
    pids=()
    for i in $(seq 0 $((N - 1))); do
        idx=$(printf "%03d" "$i")
        while [[ $(jobs -rp | wc -l) -ge "$JOBS" ]]; do
            sleep 0.5
        done
        run_pair "$idx" &
        pids+=("$!")
    done

    fail=0
    for pid in "${pids[@]}"; do
        if ! wait "$pid"; then
            fail=1
        fi
    done
    if [[ "$fail" -ne 0 ]]; then
        echo "ERROR: one or more parallel trace workers failed"
        exit 1
    fi
fi

t_end=$(date +%s)

if [[ "$SKIP_WELCH" -eq 1 || "$N" -lt 2 ]]; then
    echo "============================================================"
    echo " All ${N} trace pairs completed in $(( t_end - t_start ))s"
    echo " Skipping Welch TVLA analysis"
    if [[ "$N" -lt 2 && "$SKIP_WELCH" -ne 1 ]]; then
        echo " Reason: Welch t-test requires at least 2 traces per group"
    fi
    echo "============================================================"
    echo ""
    echo "Done. Results in: ${OUTDIR}/"
    echo "  CSVs    : ${OUTDIR}/group_a_*.csv  group_b_*.csv"
    exit 0
fi

echo "============================================================"
echo " All ${N} trace pairs completed in $(( t_end - t_start ))s"
echo " Running Welch TVLA analysis..."
echo "============================================================"
echo ""

if ! python3 "${SCRIPT_DIR}/multi_tvla_driver.py" \
    "$OUTDIR" \
    --threshold 4.5 \
    --out "${OUTDIR}/welch" \
    "$@" >> "$LOGFILE" 2>&1; then
    echo "ERROR: Welch analysis failed. See log: ${LOGFILE}"
    exit 1
fi

echo ""
echo "Done. Results in: ${OUTDIR}/"
echo "  CSVs    : ${OUTDIR}/group_a_*.csv  group_b_*.csv"
echo "  Summary : ${OUTDIR}/welch_summary.txt"
echo "  Log     : ${LOGFILE}"
